# 서버의 deploy/.env 로 복사해 채운다. 이 파일만 저장소에 있다. .env 는 커밋하지 않는다.

# 배포할 이미지
IMAGE=ghcr.io/shj5771/jobbell
TAG=latest

# Nginx 가 받을 도메인. 디스코드 Interactions Endpoint URL 은 https://<DOMAIN>/discord/interactions
DOMAIN=jobbell.example.com

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# 디스코드 애플리케이션 (Developer Portal → General Information / Bot)
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# 운영 경보를 받을 디스코드 채널 웹훅 (채널 설정 → 연동 → 웹후크)
OPS_WEBHOOK_URL=

# Grafana 관리자 비밀번호. Grafana 는 서버의 127.0.0.1:3000 에만 열린다(SSH 터널로 접속).
GRAFANA_ADMIN_PASSWORD=change-me
